; Reverse zone: 10.0.2.0/24

$TTL 1h

@       IN      SOA     dns.home.blrobinson.uk. hostmaster.home.blrobinson.uk. (
        2026110801      ; serial
        8H              ; refresh
        4H              ; retry
        4W              ; expire
        1D              ; minimum
)

@       IN      NS      dns.home.blrobinson.uk.

4    IN PTR backup.home.blrobinson.uk.
